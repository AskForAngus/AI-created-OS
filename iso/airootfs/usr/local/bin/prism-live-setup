#!/bin/bash
# Prepare the PrismOS live session: a passwordless "liveuser" that is logged in
# automatically and may start the installer. Runs only on the live medium
# (see ConditionKernelCommandLine in prism-live-setup.service); nothing created
# here ends up on the installed system.
set -euo pipefail

user=liveuser
if ! id "$user" &>/dev/null; then
    useradd -m -G wheel,audio,video,network,storage,input -s /bin/bash -c "PrismOS Live" "$user"
    passwd -d "$user" >/dev/null
fi
home=$(getent passwd "$user" | cut -d: -f6)

install -Dm440 /dev/stdin /etc/sudoers.d/10-liveuser <<<"$user ALL=(ALL) NOPASSWD: ALL"
install -Dm644 /dev/stdin /etc/polkit-1/rules.d/49-liveuser.rules <<'RULES'
polkit.addRule(function(action, subject) {
    if (subject.user == "liveuser") {
        return polkit.Result.YES;
    }
});
RULES

install -Dm644 /dev/stdin /etc/sddm.conf.d/50-live-autologin.conf <<CONF
[Autologin]
User=$user
Session=plasma
Relogin=false
CONF

# German keyboard in the greeter and the Plasma session until the user picks another one.
install -Dm644 /dev/stdin /etc/X11/xorg.conf.d/00-keyboard.conf <<'CONF'
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "de"
EndSection
CONF

# Encryption needs UEFI (kernels are kept on the EFI partition so PIN or USB
# stick can unlock the disk); hide the option on BIOS computers.
if [ ! -d /sys/firmware/efi ]; then
    sed -i 's/^enableLuksAutomatedPartitioning: true/enableLuksAutomatedPartitioning: false/' \
        /etc/calamares/modules/partition.conf
fi

as_user() { install -Dm644 -o "$user" -g "$user" /dev/stdin "$home/$1"; }
as_user .config/kxkbrc <<'CONF'
[Layout]
LayoutList=de
Use=true
CONF
# No screen locking or sleeping while someone is installing.
as_user .config/kscreenlockerrc <<'CONF'
[Daemon]
Autolock=false
LockOnResume=false
CONF
as_user .config/powerdevilrc <<'CONF'
[AC][SuspendAndShutdown]
AutoSuspendAction=0
[Battery][SuspendAndShutdown]
AutoSuspendAction=0
CONF
# The installer starts automatically and has an icon on the desktop.
as_user .config/autostart/prism-installer.desktop < /usr/share/applications/prism-installer.desktop
install -Dm755 -o "$user" -g "$user" /usr/share/applications/prism-installer.desktop "$home/Desktop/prism-installer.desktop"
chown -R "$user:$user" "$home"

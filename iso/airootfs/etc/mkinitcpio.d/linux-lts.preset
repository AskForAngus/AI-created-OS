# mkinitcpio preset file for the 'linux-lts' package on archiso.
# The live medium boots linux-zen only; this image is thrown away by mkarchiso
# (/var/tmp is emptied). The installed system gets a real preset.

PRESETS=('archiso')

ALL_kver='/boot/vmlinuz-linux-lts'
archiso_config='/etc/mkinitcpio.conf.d/archiso.conf'

archiso_image="/var/tmp/initramfs-linux-lts-live.img"
archiso_options="-z zstd"

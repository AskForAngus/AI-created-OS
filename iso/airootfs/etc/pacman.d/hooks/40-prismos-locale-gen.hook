# Generate the German and English locales while the image is built.
[Trigger]
Operation = Install
Type = Package
Target = glibc

[Action]
Description = Generating de_DE and en_US locales...
When = PostTransaction
Depends = glibc
Depends = sed
Depends = sh
Exec = /bin/sh -c "sed -i 's/^#\(de_DE\.UTF-8\)/\1/;s/^#\(en_US\.UTF-8\)/\1/' /etc/locale.gen && locale-gen"

[Unit]
Description=PrismOS-Live-Sitzung vorbereiten
ConditionKernelCommandLine=archisobasedir
After=systemd-sysusers.service systemd-tmpfiles-setup.service
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/prism-live-setup

[Install]
WantedBy=multi-user.target

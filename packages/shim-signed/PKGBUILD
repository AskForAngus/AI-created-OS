# shim signed by Microsoft (taken from Fedora), so PrismOS can boot with
# Secure Boot enabled. shim then trusts GRUB and kernels signed with the
# computer's own Machine Owner Key (see prism-target-finalize).

pkgname=shim-signed
_fedora_ver=15.8
_fedora_rel=3
pkgver=${_fedora_ver}+fedora${_fedora_rel}
pkgrel=1
pkgdesc='Initial UEFI bootloader that handles chaining to a trusted full bootloader under Secure Boot (Microsoft-signed)'
arch=('x86_64')
url='https://github.com/rhboot/shim'
license=('BSD-2-Clause')
options=('!strip' '!debug')
source=("https://kojipkgs.fedoraproject.org/packages/shim/${_fedora_ver}/${_fedora_rel}/x86_64/shim-x64-${_fedora_ver}-${_fedora_rel}.x86_64.rpm")
sha256sums=('SKIP')

package() {
  install -Dm644 boot/efi/EFI/fedora/shimx64.efi "$pkgdir/usr/share/shim-signed/shimx64.efi"
  install -Dm644 boot/efi/EFI/fedora/mmx64.efi "$pkgdir/usr/share/shim-signed/mmx64.efi"
}

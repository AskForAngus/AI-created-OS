#!/usr/bin/env python3
"""Tell the user about programs that are installed in the background.

prism-pending-apps.service (running as root) works through
/var/lib/prismos/plan.json after the first boot, e.g. Flatpaks chosen in the
installer. This session helper watches that file and sends desktop
notifications: once at the start, once per finished program, once at the end.
"""

import json
import subprocess
import time
from pathlib import Path

PLAN = Path("/var/lib/prismos/plan.json")
FAILED = PLAN.with_suffix(".failed.json")
FLATPAK_APPS = Path("/var/lib/flatpak/exports/share/applications")
POLL_SECONDS = 15
GIVE_UP_AFTER = 4 * 3600


def notify(title, body):
    subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                    "--object-path", "/org/freedesktop/Notifications",
                    "--method", "org.freedesktop.Notifications.Notify",
                    "PrismOS", "0", "prismos", title, body, "[]", "{}", "10000"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def pending():
    """Programs still to install; None when the plan is gone (all done or given up)."""
    try:
        plan = json.loads(PLAN.read_text())
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return False  # could not read it right now, try again later
    return plan.get("pacman", []) + plan.get("flatpak", [])


def display_name(item):
    """Human name of a program: the Name= of a Flatpak's desktop file, else the package name."""
    desktop = FLATPAK_APPS / f"{item}.desktop"
    try:
        for line in desktop.read_text().splitlines():
            if line.startswith("Name="):
                return line[5:]
    except OSError:
        pass
    return item.split(".")[-1] if "." in item else item


def main():
    waiting = pending()
    if not waiting:
        return 0
    notify("Programme werden im Hintergrund installiert",
           "Du kannst ganz normal weiterarbeiten. PrismOS meldet sich, sobald alles fertig ist:\n"
           + ", ".join(display_name(i) for i in waiting))
    started = time.monotonic()
    while time.monotonic() - started < GIVE_UP_AFTER:
        time.sleep(POLL_SECONDS)
        now = pending()
        if now is False:
            continue
        if now is None and FAILED.exists():
            notify("Nicht alle Programme konnten installiert werden",
                   "Bitte installiere sie über Discover: " + ", ".join(display_name(i) for i in waiting))
            return 0
        remaining = now or []
        for item in waiting:
            if item not in remaining:
                notify(f"{display_name(item)} ist installiert", "Du findest es im Startmenü.")
        waiting = remaining
        if not remaining:
            notify("Alle Programme sind installiert", "Viel Spaß mit PrismOS!")
            return 0
    return 0


if __name__ == "__main__":
    main()

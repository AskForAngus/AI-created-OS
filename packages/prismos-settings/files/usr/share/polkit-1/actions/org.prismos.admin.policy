<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PrismOS</vendor>
  <action id="org.prismos.admin">
    <description>Change PrismOS system settings</description>
    <description xml:lang="de">PrismOS-Systemeinstellungen ändern</description>
    <message>Authentication is required to change system settings</message>
    <message xml:lang="de">Zum Ändern der Systemeinstellungen ist dein Passwort nötig</message>
    <icon_name>prismos</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/prismos/prism-admin</annotate>
  </action>
</policyconfig>

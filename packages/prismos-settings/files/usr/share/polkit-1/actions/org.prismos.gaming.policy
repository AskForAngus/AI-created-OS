<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PrismOS</vendor>
  <action id="org.prismos.gaming">
    <description>Switch the PrismOS gaming mode</description>
    <description xml:lang="de">PrismOS-Gaming-Modus umschalten</description>
    <message>Authentication is required to switch the gaming mode</message>
    <message xml:lang="de">Zum Umschalten des Gaming-Modus ist dein Passwort nötig</message>
    <icon_name>input-gaming</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/prismos/prism-gaming-helper</annotate>
  </action>
</policyconfig>
